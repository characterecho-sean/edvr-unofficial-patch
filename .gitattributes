# Normalise to LF in the repository, check out native.
* text=auto

# Windows-only build scripts: cmd is happier with CRLF on disk.
*.bat text eol=crlf

# Sources are LF in every checkout, whatever core.autocrlf says. Several rigs
# read EDVR's own source as binary and search it for "\n}\n" and the like,
# which the CRLF checkout a Windows clone gets by default (core.autocrlf=true)
# can never match (issue 37). Nothing tracked is CRLF in the index, so this
# changes no stored content.
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Test fixtures are split on "\n" and merged line by line by the self-tests, so
# a CRLF checkout leaves stray \r mid-line (issue 64).
tools/*fixture*.log text eol=lf

# Generated by tools/gen_exports.py, never committed, but be explicit.
*.asm text eol=crlf
*.def text eol=crlf

# Binaries, if any ever land here.
*.dll binary
*.exe binary
*.cso binary
*.rdc binary
*.edvrlog binary

# The loader notice is hashed byte-for-byte by the dependency fetcher.
third_party/openxr/LOADER-NOTICES.txt text eol=lf

# The vendored SMAA sources (MIT, iryoku/smaa at commit 71c806a8) are stored and checked out byte-for-byte, as upstream ships them (CRLF):
# tools/gen_smaa_hlsl.py pins SMAA.hlsl's SHA-256 and the build refuses any other bytes.
src/d3d11/smaa/** -text
