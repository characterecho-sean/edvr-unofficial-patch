# Normalise to LF in the repository, check out native.
* text=auto

# Windows-only build scripts: cmd is happier with CRLF on disk.
*.bat text eol=crlf

# Generated by tools/gen_exports.py, never committed, but be explicit.
*.asm text eol=crlf
*.def text eol=crlf

# Binaries, if any ever land here.
*.dll binary
*.exe binary
*.cso binary
*.rdc binary
*.edvrlog binary
